nami run [message..]

run rsmrtk with a message

Позиційні:
  message  message to send                                           [масива] [за замовчуванням: []]

Опції:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level        [строка] [доступні варіанти: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                               [строка]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [строка]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
      --share        share the session                                                     [boolean]
  -m, --model        model to use in the format of provider/model                           [строка]
      --agent        agent to use                                                           [строка]
      --format       format: default (formatted) or json (raw JSON events)
                       [строка] [доступні варіанти: "default", "json"] [за замовчуванням: "default"]
  -f, --file         file(s) to attach to message                                           [масива]
      --title        title for the session (uses truncated prompt if no value provided)     [строка]
      --attach       attach to a running rsmrtk server (e.g., http://localhost:4096)        [строка]
  -p, --password     basic auth password (defaults to RSMRTK_SERVER_PASSWORD)               [строка]
  -u, --username     basic auth username (defaults to RSMRTK_SERVER_USERNAME or 'rsmrtk')   [строка]
      --dir          directory to run in, path on remote server if attaching                [строка]
      --port         port for the local server (defaults to random port if no value provided)[число]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [строка]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode [boolean] [за замовчуванням: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                 [boolean] [за замовчуванням: false]
"
`;

