{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "RSMRTK_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "RSMRTK_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "rsmrtk#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@rsmrtk/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@rsmrtk/function#test": {
      "outputs": []
    },
    "@rsmrtk/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@rsmrtk/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@rsmrtk/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
